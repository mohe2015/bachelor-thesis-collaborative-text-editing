<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="never" page-range-format="expanded">
  <info>
    <title>LaTeX default style (numeric, sorted by author; prose: first author et al.)</title>
    <id>http://www.zotero.org/styles/latex-default-numeric-sorted-by-author</id>
    <link href="http://www.zotero.org/styles/latex-default-numeric-sorted-by-author" rel="self"/>
    <author>
      <name>Custom</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Numeric [n] citations, bibliography sorted by author surname with numbers following that order, "Author et al." for prose citations. Mimics the default LaTeX (biblatex-style) layout.</summary>
    <updated>2026-10-01T00:00:00+00:00</updated>
  </info>

  <!-- Prose citations (#cite(<key>, form: "prose")) are rendered by the
       processor from this macro with a citation position set, so the first
       branch yields "Bauwens et al."; the real bibliography takes the else
       branch and lists all authors. -->
  <macro name="author">
    <choose>
      <if position="first subsequent ibid ibid-with-locator near-note" match="any">
        <names variable="author">
          <name form="short" and="text" delimiter=", " et-al-min="3" et-al-use-first="1"/>
          <substitute>
            <names variable="editor"/>
          </substitute>
        </names>
      </if>
      <else>
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="contextual" initialize="false" et-al-min="99" et-al-use-first="1"/>
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>

  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all" form="long" delimiter=" "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor" prefix="Ed. by ">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual" initialize="false"/>
    </names>
  </macro>

  <macro name="title-quoted">
    <text variable="title" prefix="“" suffix="”"/>
  </macro>

  <macro name="title-italic">
    <text variable="title" font-style="italic"/>
  </macro>

  <macro name="pages">
    <text variable="page" prefix="pp. "/>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="publisher-line">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="year"/>
      <text macro="pages"/>
    </group>
  </macro>

  <macro name="identifiers">
    <group delimiter=". ">
      <text variable="ISBN" prefix="isbn: "/>
      <text variable="ISSN" prefix="issn: "/>
      <text variable="DOI" prefix="doi: "/>
      <choose>
        <if variable="URL">
          <text variable="URL" prefix="url: "/>
        </if>
      </choose>
    </group>
  </macro>

  <citation collapse="citation-number" et-al-min="3" et-al-use-first="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="4" et-al-use-first="1" second-field-align="flush" entry-spacing="0">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="author"/>
        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <text macro="title-quoted"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text value="In:"/>
                <text variable="container-title"/>
                <group>
                  <text variable="volume"/>
                  <text variable="issue" prefix="."/>
                </group>
                <group prefix="(" suffix=")">
                  <text macro="year"/>
                </group>
              </group>
              <text variable="page" prefix="pp. "/>
            </group>
          </if>
          <else-if type="paper-conference chapter entry-encyclopedia" match="any">
            <text macro="title-quoted"/>
            <group delimiter=". ">
              <group delimiter=" ">
                <text value="In:"/>
                <text variable="container-title"/>
              </group>
              <text macro="editor"/>
              <text macro="publisher-line"/>
            </group>
          </else-if>
          <else-if type="book thesis report" match="any">
            <text macro="title-italic"/>
            <text macro="publisher-line"/>
          </else-if>
          <else>
            <text macro="title-italic"/>
            <text macro="publisher-line"/>
          </else>
        </choose>
        <text macro="identifiers"/>
      </group>
    </layout>
  </bibliography>
</style>