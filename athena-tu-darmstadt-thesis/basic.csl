<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       demote-non-dropping-particle="never" page-range-format="expanded"
       and="text" delimiter-precedes-last="contextual"
       et-al-min="4" et-al-use-first="1"
       default-locale="en-US">
  <info>
    <title>biblatex default (numeric, sorting=nty)</title>
    <title-short>biblatex-numeric-nty</title-short>
    <id>http://example.org/styles/biblatex-numeric-nty</id>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Approximation of plain \usepackage{biblatex}: style=numeric, sorting=nty</summary>
    <updated>2026-09-30T00:00:00+00:00</updated>
  </info>

  <!-- ===== Sorting helpers (name, title, year) ===== -->
  <macro name="sort-name">
    <names variable="author">
      <name name-as-sort-order="all" form="long"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- ===== Bibliography building blocks ===== -->
  <macro name="contributors">
    <names variable="author">
      <name/>
      <et-al/>
      <substitute>
        <names variable="editor">
          <name/>
          <label form="short" prefix=", "/>
        </names>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference thesis manuscript patent">
        <text variable="title" prefix="“" suffix="”"/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="place-publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition" suffix=" ed."/>
      </else>
    </choose>
  </macro>

  <!-- "In: ..." part -->
  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper">
        <group delimiter=", ">
          <group delimiter=" ">
            <text term="in" text-case="capitalize-first" suffix=":"/>
            <text variable="container-title" font-style="italic"/>
            <group>
              <text variable="volume"/>
              <text variable="issue" prefix="."/>
            </group>
            <date variable="issued" prefix="(" suffix=")">
              <date-part name="year"/>
            </date>
          </group>
          <text macro="pages"/>
        </group>
      </if>
      <else-if type="chapter paper-conference">
        <group delimiter=". ">
          <group delimiter=" ">
            <text term="in" text-case="capitalize-first" suffix=":"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <group delimiter=" ">
            <text value="Ed. by"/>
            <names variable="editor">
              <name/>
            </names>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- Address: Publisher, Year -->
  <macro name="publication">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="none">
        <choose>
          <if type="chapter paper-conference">
            <group delimiter=", ">
              <text macro="place-publisher"/>
              <text macro="year"/>
              <text macro="pages"/>
            </group>
          </if>
          <else-if type="thesis">
            <group delimiter=". ">
              <text variable="genre"/>
              <group delimiter=", ">
                <text variable="publisher"/>
                <text macro="year"/>
              </group>
            </group>
          </else-if>
          <else-if type="report">
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="genre"/>
                <text variable="number"/>
              </group>
              <group delimiter=", ">
                <text variable="publisher"/>
                <text macro="year"/>
              </group>
            </group>
          </else-if>
          <else>
            <group delimiter=". ">
              <text macro="edition"/>
              <group delimiter=", ">
                <text macro="place-publisher"/>
                <text macro="year"/>
              </group>
            </group>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="identifiers">
    <group delimiter=". ">
      <text variable="ISBN" prefix="ISBN: "/>
      <text variable="ISSN" prefix="ISSN: "/>
      <text variable="DOI" prefix="DOI: "/>
      <group delimiter=" ">
        <text variable="URL" prefix="URL: "/>
        <date variable="accessed" prefix="(visited on " suffix=")">
          <date-part name="year"/>
          <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
          <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
        </date>
      </group>
    </group>
  </macro>

  <!-- ===== Citations: [1], [1, 2], [1, p. 5] ===== -->
  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- ===== Bibliography: sorted by name, title, year ===== -->
  <bibliography entry-spacing="0" second-field-align="flush">
    <sort>
      <key macro="sort-name"/>
      <key variable="title"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". " suffix=".">
        <text macro="contributors"/>
        <text macro="title"/>
        <text macro="container"/>
        <text macro="publication"/>
        <text macro="identifiers"/>
      </group>
    </layout>
  </bibliography>
</style>
